#!/usr/bin/env bash
# End-to-end suite gate. Builds the release binary and runs the whole case set
# headless against isolated state directories, with a wall-clock budget that fails
# the build when exceeded. The runner refuses to touch the operator state
# directory, so this check is safe to run on a real machine.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../.." && pwd)"

# case_count_matches SUMMARY CASES_DIR: the number of cases the run recorded
# equals the number of case files in the directory, else both numbers on stderr.
# Until 2026-09-09 the suite ran 51 of 62 cases for two days with nothing
# comparing the two numbers; this is the comparison, made by the gate itself.
case_count_matches() {
    local summary="$1" cases_dir="$2" executed expected
    executed="$(jq '.cases | length' "$summary" 2>/dev/null)" || executed="unreadable"
    expected="$(find "$cases_dir" -maxdepth 1 -type f -name '*.sh' | wc -l | tr -d ' ')"
    if [ "$executed" = "$expected" ]; then
        return 0
    fi
    echo "e2e: $summary records $executed cases but $cases_dir holds $expected case files" >&2
    return 1
}

# The comparison is proven on scratch input before it judges a real run: a
# summary one case short of its directory is refused naming both numbers, and a
# matching pair passes.
case_count_selftest() {
    local tmp
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/aub-e2e-count-XXXXXX")"
    mkdir -p "$tmp/cases"
    : >"$tmp/cases/001-a.sh"
    : >"$tmp/cases/002-b.sh"
    printf '{"cases":[{"id":"001-a"}]}\n' >"$tmp/short.json"
    printf '{"cases":[{"id":"001-a"},{"id":"002-b"}]}\n' >"$tmp/full.json"
    local out
    if out="$(case_count_matches "$tmp/short.json" "$tmp/cases" 2>&1)"; then
        echo "e2e self-test: a summary one case short of its directory was accepted" >&2
        rm -rf "$tmp"
        return 1
    fi
    case "$out" in
        *"records 1 cases"*"holds 2 case files"*) : ;;
        *) echo "e2e self-test: the short-count message did not name both numbers: $out" >&2
           rm -rf "$tmp"
           return 1 ;;
    esac
    if ! case_count_matches "$tmp/full.json" "$tmp/cases" 2>/dev/null; then
        echo "e2e self-test: a matching summary was refused" >&2
        rm -rf "$tmp"
        return 1
    fi
    rm -rf "$tmp"
    echo "e2e self-test: case count comparison ok"
}

# The runner's own self-test and the command-surface consistency check need no
# release binary, so they run before the build: a broken runner or an unexercised
# command fails fast instead of waiting on a compile first.
if ! "$repo_root/tests/e2e/run.sh" --self-test; then
    echo "==> e2e FAILED (runner self-test)"
    exit 1
fi
if ! case_count_selftest; then
    echo "==> e2e FAILED (case count self-test)"
    exit 1
fi
if ! "$repo_root/tests/e2e/run.sh" --check-consistency; then
    echo "==> e2e FAILED (command-surface consistency check)"
    exit 1
fi

# The release binary is what the runner drives: the properties under test include
# exit statuses, stream separation and the behaviour of a process that starts and
# exits, none of which a library call proves. A failed build must fail the check
# here, loudly: without this, the runner would be invoked against a missing binary
# and the resulting error would be attributed to the runner rather than to the
# commit that broke the crate.
cargo build --release || {
    echo "==> e2e FAILED (release build failed; the crate must compile before the suite can run)" >&2
    exit 1
}

# Ask cargo where it actually put the binary: bin/ci points CARGO_TARGET_DIR at a
# per-worktree directory and ~/.cargo/config.toml points it at a shared build disk,
# so a hardcoded target/release path is wrong on at least one of those machines.
target_dir="$(cargo metadata --format-version 1 --no-deps | jq -r '.target_directory')"
aub_bin="$target_dir/release/aub"

# The budget is a hard gate: a suite that grows without bound is a suite that
# stops being run, and an unrun suite is a suite that proves nothing.
#
# 180s since 2026-09-11 (aub-kg2a). This one is a deliberate recalibration, not the
# slowest-reading-times-1.25 rule the 90s below followed. Three readings on this
# desktop over the night of 2026-09-10 to 11, with the case count at 62 of 62 on
# each: 115s (the aub-71j.7 gate, run by hand, one lane), 117s (the aub-8av3
# landing, one lane) and 119s (the aub-80nm plus aub-6wym landing, two lanes). The
# 1.25 rule on the slowest of those would give 150s. 180s is set instead, about
# 1.5x, because the cost driver grows on its own: every case builds a fresh state
# directory and applies every migration, so each migration a bead adds is paid 62
# times over by cases that never mention it, and a budget with rule-minimum
# headroom drifts back under the suite as the product grows rather than as the
# suite does. The three readings were taken with the landing's own lanes in
# flight, so they are an upper bound and not a quiet-machine figure; summed case
# time on the same tree is 56.1s.
#
# The readings come from this desktop and not from the CI runner, as the 90s ones
# did, because the desktop is the machine that decides whether work lands here:
# three landings went red on the 90s budget in one night, each with
# attribution=environment and no bead convicted.
#
# Measured again on 2026-09-11 with nothing else running, three consecutive
# readings on main at 63 of 63 cases: 73s, 96s and 64s, all green. That is a 32s
# spread with no change to the tree, half again the smallest reading, and it does
# not track the io pressure read at launch (the 96s run started at avg10=7.86, the
# 64s run at avg10=4.33). What it does track is what the page cache already holds:
# in the first reading case 015 alone cost 14.6s and in the next two it cost 1.8s
# and 1.9s, with the summed case time moving 53.8s, 76.4s, 44.5s. The suite reads
# its binary and fixtures from a SATA SSD shared with every cargo target on this
# machine, so a cold run pays for that and a warm one does not.
#
# This is what the budget has to absorb, and it is why the headroom is 1.5x rather
# than the rule's 1.25x: the quantity being bounded swings by 50 percent on its
# own. Anyone tempted to tighten it back should re-read those three numbers first.
# The per-case migration cost was measured on the same day and is not the driver:
# 3.33ms per migration application (the repo's own migration_matrix test prints
# it), about 127ms for a fresh ledger's whole chain, roughly 9.3s across the 73
# ledgers a run creates, so a new migration adds about 0.24s to the suite.
#
# It was 90s from 2026-09-09 to 2026-09-11 (aub-e2e-cost-rjxc), from three
# consecutive readings on the CI runner after the suite's cost was cut: 66s, 69s
# and 71s (run 34342284685, attempts 1 to 3), with the case count asserted at 61
# of 61 on each. The rule there was the slowest reading times 1.25, rounded up to
# a multiple of 10s; the pair the suite started with was 120s against 96-98s,
# about 1.22x, and that kept the same headroom.
#
# The history the number carries. It was 120s until 2026-09-09, met only because
# the suite silently ran 51 of its 62 cases: run.sh read its case list on stdin
# and a step whose program also read stdin (script's pty relay) drained it,
# skipping every case sorted after that reader. Commit 2efab9f closed the cause,
# the honest 62-case suite cost 194s on the runner, and the budget went to 240s
# the same day. Three cuts then brought the suite down without hiding a case:
# aub-rlfn fails the run and this gate when fewer cases ran than the directory
# holds; aub-oc56 took case 022 out, the same 4000 spawns 85-status-latency-budget
# already runs and enforces, with its artifact-shape assertions moved there;
# aub-6fuo cut the two ten-tick cases from 41s each to about 1s and 10s, the
# sleep their classifier condition needs. Case 015 stays, evidentiary and about
# 7s; its header says why.
budget_seconds="${E2E_BUDGET_SECONDS:-180}"

start="$(date +%s)"
AUB_BIN="$aub_bin" "$repo_root/tests/e2e/run.sh" --state-dir "$(mktemp -d "${TMPDIR:-/tmp}/aub-e2e-ci-XXXXXX")"
rc=$?
elapsed=$(( $(date +%s) - start ))

echo "e2e suite: ${elapsed}s (budget ${budget_seconds}s)"
if [ "$rc" -ne 0 ]; then
    echo "==> e2e FAILED (exit $rc)"
    exit 1
fi

# Independent of the runner's own count: the newest run's summary.json is read
# here and compared against the case directory by this process, which shares no
# state with the loop that produced it. The runner refuses a short run on its
# own; this catches a runner whose count and whose loop failed together.
newest_run="$(find "$repo_root/tests/e2e/runs" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -rn | head -1 | cut -d' ' -f2-)"
if ! case_count_matches "$newest_run/summary.json" "$repo_root/tests/e2e/cases"; then
    echo "==> e2e FAILED (case count)"
    exit 1
fi
if [ "$elapsed" -gt "$budget_seconds" ]; then
    echo "==> e2e FAILED (budget exceeded: ${elapsed}s > ${budget_seconds}s)"
    exit 1
fi

echo "e2e suite pass."

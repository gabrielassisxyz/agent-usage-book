#!/usr/bin/env bash
# The pane work-cycle and central verification guard (aub-x5bo, aub-ijph):
# AGENTS.md must name the checks a pane runs before moving a bead to batch_pending,
# name the owner of the one gate class left outside that subset, document the
# bin/last-verify command for panes to query central verification freshness before
# committing, and document orchestrator verdict recording in Phase 2.
#
# Three parts:
#   conformance  asserts the document names the subset, names lint's owner, documents
#                bin/last-verify and its three states (green at HEAD, stale with distance,
#                none), documents Phase 2 verdict recording, and records the subset
#                measurements.
#   unit         verifies bin/last-verify handles all three states and distance
#                calculation accurately without compilation and in under 250 ms.
#   integration  runs the written subset against a scratch checkout (blind to lint,
#                stopped by formatting/prose/syntax) and exercises the record -> commit ->
#                stale with distance 1 cycle against a real tree.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"
repo_root="$(pwd)"

doc="AGENTS.md"
fail=0

# Extract sections
phase1="$(awk '
    /^### Phase 1: code-first wave/ { grab = 1; next }
    grab && /^### / { exit }
    grab { print }
' "$doc")"

if [ -z "$phase1" ]; then
    echo "$doc: no '### Phase 1: code-first wave' section" >&2
    exit 1
fi

phase2="$(awk '
    /^### Phase 2: batch verify and close/ { grab = 1; next }
    grab && /^### / { exit }
    grab { print }
' "$doc")"

if [ -z "$phase2" ]; then
    echo "$doc: no '### Phase 2: batch verify and close' section" >&2
    exit 1
fi

compiler_checks="$(awk '
    /^## Compiler Checks \(CRITICAL\)/ { grab = 1; next }
    grab && /^## / { exit }
    grab { print }
' "$doc")"

if [ -z "$compiler_checks" ]; then
    echo "$doc: no '## Compiler Checks (CRITICAL)' section" >&2
    exit 1
fi

require() {  # $1 = criterion, $2 = haystack, $3.. = substrings required
    local criterion="$1" haystack="$2"
    shift 2
    local h_norm n_norm needle
    h_norm="$(printf '%s' "$haystack" | tr '\n\t' ' ' | tr -s ' ')"
    for needle in "$@"; do
        n_norm="$(printf '%s' "$needle" | tr '\n\t' ' ' | tr -s ' ')"
        if ! printf '%s' "$h_norm" | command grep -qF -- "$n_norm"; then
            echo "$doc: $criterion: missing '$needle'" >&2
            fail=1
        fi
    done
}

forbid() {  # $1 = criterion, $2 = haystack, $3.. = substrings forbidden
    local criterion="$1" haystack="$2"
    shift 2
    local needle
    for needle in "$@"; do
        if printf '%s' "$haystack" | command grep -qF -- "$needle"; then
            echo "$doc: $criterion: forbidden '$needle' present" >&2
            fail=1
        fi
    done
}

# --- Conformance checks ---

# Criterion 1: the work-cycle names the check set a pane runs, in full.
require "the pane check subset" "$phase1" \
    'cargo check -p agent-usage-book' \
    'cargo fmt --check' \
    'bin/slop-guard' \
    'which is these three and nothing else'

# Criterion 2: the one class outside the subset is named, with its owner, and with the
# statement that the pane is not answerable for it.
require "lint is outside the subset and has an owner" "$phase1" \
    'One class of gate failure is invisible to you, and it is lint' \
    'you are not held responsible for one' \
    'The orchestrator catches and repairs lint in Phase 2'

require "the orchestrator repairs lint without a rework note" "$phase2" \
    'Lint failures are exempt' \
    'No rework note ever returns a bead for lint' \
    'Formatting and prose are not exempt'

# Criterion 4: the pane is given bin/last-verify to check central verification, and the
# unknowable main sentence is replaced.
forbid "the unknowable main sentence is dropped" "$phase1" \
    'You have no way to know whether `main` is already red from lint'

require "the pane is given bin/last-verify and its three states" "$phase1" \
    'bin/last-verify' \
    'green at HEAD' \
    'stale: green at <sha> (distance N)' \
    'none: no central verification verdict recorded' \
    '.beads/last-verify' \
    'machine-local' \
    'Do not read a green subset as a clean `main`' \
    'br list --status rework` does not answer this either'

require "the orchestrator documents central verification verdict recording in Phase 2" "$phase2" \
    'bin/last-verify --record' \
    '.beads/last-verify' \
    'step 5' \
    'machine-local'

# Criteria 3 and 5: the choice is recorded with the measurement that decided it, not with a
# category argument.
require "the subset is justified by measurement" "$compiler_checks" \
    'chosen by measurement rather than by category' \
    'Formatting and prose are in the subset because they are nearly free' \
    'Clippy is not in the subset, and that is a deliberate hole with an owner' \
    '2356 ms' \
    '100 ms' \
    '831 ms' \
    '4780 ms'

# --- Unit tests: bin/last-verify states and performance ---
scratch_unit="$(mktemp -d "${TMPDIR:-/tmp}/aub-last-verify-unit-XXXXXX")"
trap 'rm -rf "$scratch_unit"' EXIT

git init --quiet "$scratch_unit"
git -C "$scratch_unit" config user.email test@example.invalid
git -C "$scratch_unit" config user.name test
git -C "$scratch_unit" config commit.gpgsign false

printf 'base\n' > "$scratch_unit/file.txt"
git -C "$scratch_unit" add file.txt
git -C "$scratch_unit" commit --quiet -m "commit 1"
c1="$(git -C "$scratch_unit" rev-parse HEAD)"
c1_short="$(git -C "$scratch_unit" rev-parse --short HEAD)"

# State 1: no verdict recorded
out="$(cd "$scratch_unit" && "$repo_root/bin/last-verify")"
if [ "$out" != "none: no central verification verdict recorded" ]; then
    echo "unit: expected 'none: no central verification verdict recorded', got: '$out'" >&2
    fail=1
fi

# State 2: green at HEAD
mkdir -p "$scratch_unit/.beads"
printf '%s\n' "$c1" > "$scratch_unit/.beads/last-verify"
out="$(cd "$scratch_unit" && "$repo_root/bin/last-verify")"
if [ "$out" != "green at HEAD ($c1_short)" ]; then
    echo "unit: expected 'green at HEAD ($c1_short)', got: '$out'" >&2
    fail=1
fi

# State 3: stale with distance 1
printf 'c2\n' >> "$scratch_unit/file.txt"
git -C "$scratch_unit" commit --quiet -am "commit 2"
c2="$(git -C "$scratch_unit" rev-parse HEAD)"
c2_short="$(git -C "$scratch_unit" rev-parse --short HEAD)"

out="$(cd "$scratch_unit" && "$repo_root/bin/last-verify")"
if [ "$out" != "stale: green at $c1_short (distance 1)" ]; then
    echo "unit: expected 'stale: green at $c1_short (distance 1)', got: '$out'" >&2
    fail=1
fi

# State 3: stale with distance 3
printf 'c3\n' >> "$scratch_unit/file.txt"
git -C "$scratch_unit" commit --quiet -am "commit 3"
printf 'c4\n' >> "$scratch_unit/file.txt"
git -C "$scratch_unit" commit --quiet -am "commit 4"
out="$(cd "$scratch_unit" && "$repo_root/bin/last-verify")"
if [ "$out" != "stale: green at $c1_short (distance 3)" ]; then
    echo "unit: expected 'stale: green at $c1_short (distance 3)', got: '$out'" >&2
    fail=1
fi

# --- Integration: real tree record, commit, stale distance 1, latency, and zero compilation ---
scratch_tree="$(mktemp -d "${TMPDIR:-/tmp}/aub-last-verify-tree-XXXXXX")"
trap 'rm -rf "$scratch_unit" "$scratch_tree"' EXIT

git clone --quiet --local --no-hardlinks "$repo_root" "$scratch_tree"
cp -a "$repo_root/bin/last-verify" "$scratch_tree/bin/last-verify"
git -C "$scratch_tree" config user.email test@example.invalid
git -C "$scratch_tree" config user.name test
git -C "$scratch_tree" config commit.gpgsign false

# Record verdict at HEAD
(cd "$scratch_tree" && bin/last-verify --record >/dev/null)
head_short="$(git -C "$scratch_tree" rev-parse --short HEAD)"

# Read back green at HEAD and measure latency
start_ms="$(date +%s%3N 2>/dev/null || echo 0)"
out_head="$(cd "$scratch_tree" && bin/last-verify)"
end_ms="$(date +%s%3N 2>/dev/null || echo 0)"

if [ "$out_head" != "green at HEAD ($head_short)" ]; then
    echo "integration: after record, expected 'green at HEAD ($head_short)', got: '$out_head'" >&2
    fail=1
fi

if [ "$start_ms" -ne 0 ] && [ "$end_ms" -ne 0 ]; then
    elapsed_ms=$(( end_ms - start_ms ))
    if [ "$elapsed_ms" -gt 250 ]; then
        echo "integration: bin/last-verify took ${elapsed_ms}ms (budget: 250ms)" >&2
        fail=1
    fi
fi

# Land a commit on top of the recorded verdict
printf '\n# a new commit\n' >> "$scratch_tree/AGENTS.md"
git -C "$scratch_tree" commit --quiet -am "commit on top of verify"

# Read back: must report stale with distance 1
out_stale="$(cd "$scratch_tree" && bin/last-verify)"
if [ "$out_stale" != "stale: green at $head_short (distance 1)" ]; then
    echo "integration: after new commit, expected 'stale: green at $head_short (distance 1)', got: '$out_stale'" >&2
    fail=1
fi

# Assert nothing was compiled (no target directory created by bin/last-verify)
if [ -d "$scratch_tree/target" ]; then
    echo "integration: bin/last-verify created target directory, violating zero-compilation invariant" >&2
    fail=1
fi

# --- Integration: run the written work-cycle and check it does what the document claims ---
scratch="$(mktemp -d "${TMPDIR:-/tmp}/aub-work-cycle-XXXXXX")"
trap 'rm -rf "$scratch_unit" "$scratch_tree" "$scratch"' EXIT

git clone --quiet --local --no-hardlinks "$repo_root" "$scratch"
cp -a "$repo_root/bin/last-verify" "$scratch/bin/last-verify"
cp -a "$repo_root/AGENTS.md" "$scratch/AGENTS.md"
export CARGO_TARGET_DIR="$scratch/target"

run_subset() {
    (cd "$scratch" && cargo check -p agent-usage-book) >/dev/null 2>&1 || return 1
    (cd "$scratch" && cargo fmt --check) >/dev/null 2>&1 || return 1
    (cd "$scratch" && bin/slop-guard) >/dev/null 2>&1 || return 1
    return 0
}

# --- Phase A: a lint-only defect, which is the declared hole
cat >> "$scratch/tests/module_skeleton.rs" << 'EOF2'

#[test]
fn aub_vcx_3_collapsible_if_let_regression() {
    if let Some(x) = Some(1) {
        if let Some(y) = Some(x) {
            assert_eq!(y, 1);
        }
    }
}
EOF2

if ! run_subset; then
    echo "integration: the pane subset failed on a lint-only defect, but the document tells a pane it will not see one" >&2
    fail=1
fi

if (cd "$scratch" && cargo clippy --all-targets -- -D warnings) >/dev/null 2>&1; then
    echo "integration: clippy did not catch the planted collapsible if let, so the class the document hands to the orchestrator is not real" >&2
    fail=1
fi

# --- Phase B: formatting and prose
printf '\n\n\n' >> "$scratch/src/build_info.rs"
if (cd "$scratch" && cargo fmt --check) >/dev/null 2>&1; then
    echo "integration: cargo fmt --check did not catch the planted formatting violation" >&2
    fail=1
fi
if run_subset; then
    echo "integration: the pane subset passed with a formatting violation planted, so a pane would park that bead" >&2
    fail=1
fi

printf '\n// Em-dash: \xe2\x80\x94\n' >> "$scratch/AGENTS.md"
if (cd "$scratch" && bin/slop-guard) >/dev/null 2>&1; then
    echo "integration: bin/slop-guard did not catch the planted prose em-dash" >&2
    fail=1
fi

# --- Phase C: discrimination
printf 'fn syntax_error_probe(\n' >> "$scratch/src/lib.rs"
if (cd "$scratch" && cargo check -p agent-usage-book) >/dev/null 2>&1; then
    echo "integration: cargo check did not catch a real syntax error" >&2
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo "==> pane-work-cycle FAILED" >&2
    exit 1
fi

echo "pane-work-cycle: the subset is named and measured, lint is owned by the orchestrator, and the written work-cycle behaves as the document claims."

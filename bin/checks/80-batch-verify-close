#!/usr/bin/env bash
# The batch-verify close protocol guard (aub-h1nx): AGENTS.md must document a Phase 2 close
# procedure that the installed tracker accepts, refuses to close a bead that remains named
# as unenforced in the invariants table, names where batch-verify evidence lives, how it is
# audited, and why structured gate reporting was dropped rather than configured.
#
# Two halves, following the pattern of bin/checks/75-commit-protocol and bin/checks/78-pane-work-cycle:
#   conformance  asserts the document drops the refused `br gate report` command, gives the
#                supported `br close` command with `--reason` and `--transition-comment`,
#                validates that the documented close flags are accepted by the installed `br`,
#                requires the invariant-row update duty, names where evidence lives and how to
#                query it, and records why the structured gate was dropped instead of configured.
#   integration  runs the documented close procedure on a scratch tracker against a bead in
#                `batch_pending`, asserting that the wave refuses a still-unenforced row, then
#                closes only after the fixture row and summary counts are updated.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)"

doc="AGENTS.md"
fail=0

# Extract Phase 2 section
phase2="$(awk '
    /^### Phase 2: batch verify and close/ { grab = 1; next }
    grab && /^### / { exit }
    grab { print }
' "$doc")"

if [ -z "$phase2" ]; then
    echo "$doc: no '### Phase 2: batch verify and close' section" >&2
    exit 1
fi

require() {  # $1 = criterion, $2 = haystack, $3.. = substrings required
    local criterion="$1" haystack="$2"
    shift 2
    local h_norm n_norm needle
    h_norm="$(printf '%s' "$haystack" | tr '\n\t' ' ' | tr -s ' ')"
    for needle in "$@"; do
        n_norm="$(printf '%s' "$needle" | tr '\n\t' ' ' | tr -s ' ')"
        if ! printf '%s' "$h_norm" | command grep -qF -- "$n_norm"; then
            echo "$doc: $criterion: missing '$needle'" >&2
            fail=1
        fi
    done
}

forbid() {  # $1 = criterion, $2 = haystack, $3.. = substrings forbidden
    local criterion="$1" haystack="$2"
    shift 2
    local needle
    for needle in "$@"; do
        if printf '%s' "$haystack" | command grep -qF -- "$needle"; then
            echo "$doc: $criterion: forbidden '$needle' present" >&2
            fail=1
        fi
    done
}

# --- Conformance checks ---

# Criterion 1: AGENTS.md stops printing the refused `br gate report` command and gives the supported close command.
forbid "the refused gate report command is dropped" "$phase2" \
    'br gate report <id>' \
    '--gate batch_verify'

require "the supported close command is printed" "$phase2" \
    'br close <id> --reason "<evidence>" --transition-comment "<batch summary>"'

require "invariant rows travel with a close" "$phase2" \
    'If an unenforced row still names that bead, the wave refuses to close it' \
    'same commit series that flips the row to its enforcing path and check' \
    'updates both enforcement-summary counts'

# Verify that the flags documented in AGENTS.md are accepted by the installed `br`.
#
# Only where `br` is installed. A CI runner has no tracker, and `br close --help` there produces
# no output at all, so an unguarded probe reports "installed br close does not accept --reason"
# about a `br` that is not installed at all. That is a false finding of exactly the kind this
# check exists to prevent, and it would fire against a perfectly correct document.
if command -v br >/dev/null 2>&1; then
    br_close_help="$(br close --help 2>&1 || true)"
    if ! printf '%s' "$br_close_help" | command grep -qF -- "--reason"; then
        echo "installed br close does not accept --reason" >&2
        fail=1
    fi
    if ! printf '%s' "$br_close_help" | command grep -qF -- "--transition-comment"; then
        echo "installed br close does not accept --transition-comment" >&2
        fail=1
    fi
else
    echo "br flag conformance: SKIPPED, br is not installed here"
fi

# Criterion 2: The reason for dropping structured gates is recorded so the next reader does not reopen it.
require "reason for dropping structured gate" "$phase2" \
    'Why structured gate reporting (`br gate report`) was dropped instead of configured' \
    'live tracker' \
    'bin/swarm-dispatch'

# Criterion 5: The document names where batch-verify evidence lives and what makes it auditable.
require "batch-verify evidence location and audit" "$phase2" \
    'Batch-verify evidence lives directly in `--reason` and `--transition-comment`' \
    'br show <id>' \
    'close_reason'

# Criterion 6: a compile-fail failure on a bead whose diff does not touch the fixture is a
# trait-graph consequence, not that bead's rework, so the orchestrator does not attribute it
# to the wrong bead (aub-tojp).
require "compile-fail failures are trait-graph consequences, not rework" "$phase2" \
    'compile-fail failure on a bead whose diff does not touch the fixture' \
    'trait-graph consequence' \
    'compile_fail_regenerate'

# --- Integration: drive a bead batch_pending -> closed on a scratch tracker ---
#
# The integration half needs the `br` binary, and CI runners do not have it. A check that fails
# because the environment lacks the tool under test reports a defect that does not exist: it
# would fail identically against a perfectly correct document. So the conformance half above,
# which reads only the document, runs everywhere, and this half runs where the tracker exists.
# It says out loud when it is skipped, because a silent skip is how a check quietly stops
# meaning anything.
if ! command -v br >/dev/null 2>&1; then
    echo "integration: SKIPPED, br is not installed here (the document conformance above still ran)"
    exit "$fail"
fi

scratch="$(mktemp -d "${TMPDIR:-/tmp}/aub-batch-verify-close-XXXXXX")"
trap 'rm -rf "$scratch"' EXIT

git init --quiet "$scratch"
git -C "$scratch" config user.email orchestrator@example.invalid
git -C "$scratch" config user.name orchestrator

(
    cd "$scratch"
    br init --quiet 2>/dev/null || br init
    chmod 700 .beads
)

create_json="$( (cd "$scratch" && br create --title "Scratch batch-verify bead" --type task --priority 2 --json) 2>/dev/null || true )"
bead_id="$(printf '%s' "$create_json" | jq -r 'if type=="array" then .[0].id else .id end // empty')"
if [ -z "$bead_id" ]; then
    echo "integration: failed to create scratch bead" >&2
    exit 1
fi

(cd "$scratch" && br update "$bead_id" --status in_progress >/dev/null)
(cd "$scratch" && br update "$bead_id" --status batch_pending >/dev/null)

invariants="$scratch/docs/INVARIANTS.md"
mkdir -p "$(dirname "$invariants")"
cat > "$invariants" <<EOF
| # | Invariant | Enforcing path | Test or constraint |
|---:|---|---|---|
| 9 | Scratch close invariant. | unenforced $bead_id | (scratch invariant test) |

## Enforcement status

Of the 1 invariants above, 0 are enforced by mechanical checks present at HEAD, and 1 are unenforced and tracked by open beads in the tracker.
EOF

assert_invariant_summary_matches_rows() { # $1 = INVARIANTS path
    local table="$1" enforced unenforced
    enforced="$(awk -F '|' '/^\|[[:space:]]*[0-9]+[[:space:]]*\|/ && $4 !~ /unenforced/ { count += 1 } END { print count + 0 }' "$table")"
    unenforced="$(awk -F '|' '/^\|[[:space:]]*[0-9]+[[:space:]]*\|/ && $4 ~ /unenforced/ { count += 1 } END { print count + 0 }' "$table")"
    if ! command grep -qF -- "$enforced are enforced" "$table" || ! command grep -qF -- "$unenforced are unenforced" "$table"; then
        echo "invariant summary does not match rows in $table" >&2
        return 1
    fi
}

wave_close_allows_bead() { # $1 = bead id, $2 = optional repo_dir or INVARIANTS path
    local candidate_bead="$1"
    local target="${2:-.}"
    local table
    if [ -f "$target" ]; then
        table="$target"
    elif [ -d "$target" ]; then
        table="$target/docs/INVARIANTS.md"
    else
        table="docs/INVARIANTS.md"
    fi

    if [ ! -f "$table" ]; then
        echo "refusing close: $table not found" >&2
        return 1
    fi

    local matched_row
    matched_row="$(awk -F '|' -v bead="$candidate_bead" '
        /^\|[[:space:]]*[0-9]+[[:space:]]*\|/ && $4 ~ ("unenforced[[:space:]]+" bead "([[:space:]]|$)") {
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2);
            print $2;
            exit;
        }
    ' "$table")"

    if [ -n "$matched_row" ]; then
        echo "refusing close: invariant row $matched_row still names $candidate_bead as unenforced" >&2
        return 1
    fi

    assert_invariant_summary_matches_rows "$table"
}

# --- Unit assertions over refusal predicate against repo docs/INVARIANTS.md ---

# Unit 1: A bead named by an unenforced row is refused, naming the row number and the bead id.
# The fixture is a copy of the real table with its first row flipped to unenforced, rather than a
# row read out of the live document. Every landed bead moves a row from unenforced to enforced, so
# the live table trends towards zero unenforced rows, and a unit that needs one to exist fails at
# the moment the project succeeds: repointing invariant 12 took the table to 27 enforced and 0
# unenforced, and this unit went red on a document that had just become correct. Copying the real
# table rather than writing a synthetic one keeps the predicate's parsing under test against the
# formatting it actually has to survive.
unit_table="$scratch/INVARIANTS-planted.md"
real_unenforced_bead="aub-fixture-unenforced-row"
awk -F '|' -v bead="$real_unenforced_bead" 'BEGIN { OFS = "|" }
    !planted && /^\|[[:space:]]*[0-9]+[[:space:]]*\|/ { $4 = " unenforced " bead " "; planted = 1 }
    { print }
' docs/INVARIANTS.md > "$unit_table"

real_unenforced_row="$(awk -F '|' -v bead="$real_unenforced_bead" '$4 ~ ("unenforced[[:space:]]+" bead "([[:space:]]|$)") { gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2; exit }' "$unit_table")"
if [ -z "$real_unenforced_row" ]; then
    echo "unit: could not plant an unenforced row into the INVARIANTS fixture" >&2
    fail=1
fi

# Keep the fixture's summary consistent with its own rows, so what this unit proves is the refusal
# and not a summary mismatch, which would refuse every bead for an unrelated reason.
planted_enforced="$(awk -F '|' '/^\|[[:space:]]*[0-9]+[[:space:]]*\|/ && $4 !~ /unenforced/ { c += 1 } END { print c + 0 }' "$unit_table")"
planted_unenforced="$(awk -F '|' '/^\|[[:space:]]*[0-9]+[[:space:]]*\|/ && $4 ~ /unenforced/ { c += 1 } END { print c + 0 }' "$unit_table")"
sed -i -E "s/[0-9]+ are enforced/$planted_enforced are enforced/; s/[0-9]+ are unenforced/$planted_unenforced are unenforced/" "$unit_table"

refusal_out="$(wave_close_allows_bead "$real_unenforced_bead" "$unit_table" 2>&1 || true)"
if wave_close_allows_bead "$real_unenforced_bead" "$unit_table" >/dev/null 2>&1; then
    echo "unit: wave_close_allows_bead allowed close of $real_unenforced_bead which is unenforced in the fixture" >&2
    fail=1
fi
if ! printf '%s' "$refusal_out" | command grep -qF "row $real_unenforced_row" || ! printf '%s' "$refusal_out" | command grep -qF "$real_unenforced_bead"; then
    echo "unit: refusal message did not name row number and bead id: '$refusal_out'" >&2
    fail=1
fi

# Unit 2: Planted negative: a bead named by no row closes normally (not a blanket refusal)
planted_negative_bead="aub-planted-negative-test-bead"
if ! wave_close_allows_bead "$planted_negative_bead" >/dev/null 2>&1; then
    echo "unit: wave_close_allows_bead refused $planted_negative_bead which is not named by any invariant row" >&2
    fail=1
fi

# Unit 3: A bead whose row is enforced closes normally
enforced_bead="aub-eu7.2"
if ! wave_close_allows_bead "$enforced_bead" >/dev/null 2>&1; then
    echo "unit: wave_close_allows_bead refused $enforced_bead whose invariant row is enforced" >&2
    fail=1
fi

# Run the documented close command
evidence="commit:0123456789abcdef suites:unit,integration,e2e"
batch_summary="batch 42: union green across 5 beads"

# Before close: attempt close with unenforced invariant row; must refuse and leave tracker unchanged
scratch_refusal_out="$(wave_close_allows_bead "$bead_id" "$scratch" 2>&1 || true)"
if wave_close_allows_bead "$bead_id" "$scratch" >/dev/null 2>&1; then
    echo "integration: wave allowed a close while an unenforced invariant row named the bead" >&2
    fail=1
fi
if ! printf '%s' "$scratch_refusal_out" | command grep -qF "row 9" || ! printf '%s' "$scratch_refusal_out" | command grep -qF "$bead_id"; then
    echo "integration: scratch refusal message did not name row 9 and bead id: '$scratch_refusal_out'" >&2
    fail=1
fi

# Verify bead remains in batch_pending after refusal (tracker unchanged)
initial_bead_json="$( (cd "$scratch" && br show --json "$bead_id") 2>/dev/null || true )"
initial_status="$(printf '%s' "$initial_bead_json" | jq -r 'if type=="array" then .[0].status else .status end // empty')"
if [ "$initial_status" != "batch_pending" ]; then
    echo "integration: bead status changed despite refusal: expected 'batch_pending', got '$initial_status'" >&2
    fail=1
fi

# Update fixture to enforce row 9 and update summary counts
sed -i "s@| unenforced $bead_id |@| src/lib.rs |@; s@0 are enforced@1 are enforced@; s@1 are unenforced@0 are unenforced@" "$invariants"

if ! wave_close_allows_bead "$bead_id" "$scratch"; then
    echo "integration: wave refused close after row was updated to enforced" >&2
    fail=1
elif ! (cd "$scratch" && br close "$bead_id" --reason "$evidence" --transition-comment "$batch_summary" >/dev/null 2>&1); then
    echo "integration: documented close command failed on batch_pending bead" >&2
    fail=1
fi

# Inspect the closed bead to assert evidence was durably recorded and queryable
bead_json="$( (cd "$scratch" && br show --json "$bead_id") 2>/dev/null || true )"
status="$(printf '%s' "$bead_json" | jq -r 'if type=="array" then .[0].status else .status end // empty')"
close_reason="$(printf '%s' "$bead_json" | jq -r 'if type=="array" then .[0].close_reason else .close_reason end // empty')"
comment_text="$(printf '%s' "$bead_json" | jq -r 'if type=="array" then .[0].comments[0].text else .comments[0].text end // empty')"

if [ "$status" != "closed" ]; then
    echo "integration: bead was not closed: status is '$status'" >&2
    fail=1
fi

if [ "$close_reason" != "$evidence" ]; then
    echo "integration: close_reason mismatch: expected '$evidence', got '$close_reason'" >&2
    fail=1
fi

if [ "$comment_text" != "$batch_summary" ]; then
    echo "integration: transition comment mismatch: expected '$batch_summary', got '$comment_text'" >&2
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo "==> batch-verify-close FAILED" >&2
    exit 1
fi

echo "batch-verify-close: the wave refuses an unchanged invariant row, then closes after its row and summary update; evidence remains documented and auditable."

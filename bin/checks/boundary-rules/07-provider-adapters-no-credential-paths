#!/usr/bin/env bash
# Boundary: provider adapters must not resolve credential paths themselves.
# Design: PLAN.md section 8.2 ("provider adapters resolving arbitrary credential paths
#   themselves") and section 9 ("A provider adapter receives: a resolved credential
#   handle").
# Detection: any reference to crate::auth or crate::config in the meter module source,
#   wherever it lives: the flat file when it is a file, every .rs under the directory
#   when it is a directory. meter owns the provider adapters; auth and config own credential
#   acquisition and paths, so reaching them is the adapter resolving credentials itself.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

source "$script_dir/lib/module-files.sh"

sources=()
while IFS= read -r file; do
    [ -n "$file" ] && sources+=("$file")
done < <(module_files meter)

if [ "${#sources[@]}" -eq 0 ]; then
    exit 2
fi

matches="$(grep -nHE 'crate::(auth|config)([^A-Za-z0-9_]|$)' "${sources[@]}" 2>/dev/null || true)"
if [ -n "$matches" ]; then
    echo "provider adapters resolve credential paths (crate::auth or crate::config):" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
exit 0

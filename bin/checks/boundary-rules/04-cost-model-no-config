#!/usr/bin/env bash
# Boundary: cost_model must not read configuration files directly.
# Design: PLAN.md section 8.2 ("cost_model reading configuration files directly").
# Detection: any reference to crate::config in the cost_model module source.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

source_file="src/cost_model.rs"
if [ ! -r "$source_file" ]; then
    echo "cost_model must not read configuration files directly: cannot read $source_file" >&2
    exit 2
fi

matches="$(grep -nHE 'crate::config([^A-Za-z0-9_]|$)' "$source_file" 2>/dev/null || true)"
if [ -n "$matches" ]; then
    echo "cost_model reads configuration files directly (crate::config):" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
exit 0

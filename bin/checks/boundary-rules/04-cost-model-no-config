#!/usr/bin/env bash
# Boundary: cost_model must not read configuration files directly.
# Design: PLAN.md section 8.2 ("cost_model reading configuration files directly").
# Detection: any reference to crate::config in the cost_model module source,
#   wherever it lives: the flat file when it is a file, every .rs under the directory
#   when it is a directory.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

source "$script_dir/lib/module-files.sh"

sources=()
while IFS= read -r file; do
    [ -n "$file" ] && sources+=("$file")
done < <(module_files cost_model)

if [ "${#sources[@]}" -eq 0 ]; then
    exit 2
fi

matches="$(grep -nHE 'crate::config([^A-Za-z0-9_]|$)' "${sources[@]}" 2>/dev/null || true)"
if [ -n "$matches" ]; then
    echo "cost_model reads configuration files directly (crate::config):" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
exit 0

#!/usr/bin/env bash
# Boundary: advice must not construct calibration constants.
# Design: PLAN.md section 8.2 ("advice constructing calibration constants").
# Detection: any reference to crate::calibration in the advice module source.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

source_file="src/advice.rs"
if [ ! -r "$source_file" ]; then
    echo "advice must not construct calibration constants: cannot read $source_file" >&2
    exit 2
fi

matches="$(grep -nHE 'crate::calibration([^A-Za-z0-9_]|$)' "$source_file" 2>/dev/null || true)"
if [ -n "$matches" ]; then
    echo "advice constructs calibration constants (crate::calibration):" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
exit 0

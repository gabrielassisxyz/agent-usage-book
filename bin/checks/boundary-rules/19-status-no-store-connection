#!/usr/bin/env bash
# Boundary: the status workflow must not reference the store or open SQLite directly.
# Design: PLAN.md section 16.2 (the status contract's must-not list: "SQLite open",
#   "database writes"), section 34.31 ("status depends only on config-location
#   resolution, the projection parser, the clock and the renderer"), and bead
#   aub-me5.7.
# Detection: function-scoped, not module-scoped. `status` lives in the `cli` module
#   alongside every other command, and most of them use the store legitimately (124
#   references at HEAD), so a module-wide grep over the whole module would fail on
#   unrelated commands rather than on status. This rule instead extracts the body of
#   `fn status`, `fn projection_accounts` and `fn status_clock_skew_envelope` (the
#   status path and the two helpers it alone uses), each from its declaration line to
#   the next top-level `fn`, and greps only that extracted text for a direct SQLite
#   reference, a bare `Connection`, or a reference to `crate::store`. HTTP transport is
#   covered separately by boundary rule 06, and the migration path specifically by
#   rule 15; this rule is the general store edge those two do not close.
# Subject: the whole `cli` module, resolved through module_files, not the literal
#   src/cli.rs. A declaration moved into src/cli/ must stay under this rule rather than
#   leaving it scanning a file the status path no longer lives in (aub-pbx4.2).
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

source "$script_dir/lib/module-files.sh"

sources=()
while IFS= read -r file; do
    [ -n "$file" ] && sources+=("$file")
done < <(module_files cli)

if [ "${#sources[@]}" -eq 0 ]; then
    echo "status must not reference the store: no cli module source files found" >&2
    exit 2
fi

extract_body() {
    local file="$1" declaration="$2"
    awk -v decl="$declaration" '
        index($0, decl) == 1 { in_body = 1 }
        in_body && /^fn / && index($0, decl) != 1 { exit }
        in_body { print }
    ' "$file"
}

declarations=("fn status(" "fn projection_accounts(" "fn status_clock_skew_envelope(")
found_any=0
violations=""
for file in "${sources[@]}"; do
    for declaration in "${declarations[@]}"; do
        if ! grep -qF "$declaration" "$file"; then
            continue
        fi
        found_any=1
        matches="$(extract_body "$file" "$declaration" |
            grep -nE '(rusqlite::|crate::store::|\bConnection\b)' || true)"
        if [ -n "$matches" ]; then
            violations="$violations
$file:
$matches"
        fi
    done
done

if [ "$found_any" -eq 0 ]; then
    echo "status must not reference the store: none of ${declarations[*]} found in the cli module (${sources[*]})" >&2
    exit 2
fi

if [ -n "$violations" ]; then
    echo "the status workflow references the store:" >&2
    printf '%s\n' "$violations" >&2
    exit 1
fi
exit 0

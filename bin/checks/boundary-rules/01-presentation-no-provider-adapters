#!/usr/bin/env bash
# Boundary: presentation must not import provider adapters.
# Design: PLAN.md section 8.2 ("presentation importing provider adapters") and section 9
#   ("Presentation receives already-typed report objects").
# Detection: any reference to crate::meter (the module that owns provider adapters) in
#   the presentation module source.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

source_file="src/presentation.rs"
if [ ! -r "$source_file" ]; then
    echo "presentation must not import provider adapters: cannot read $source_file" >&2
    exit 2
fi

matches="$(grep -nHE 'crate::meter([^A-Za-z0-9_]|$)' "$source_file" 2>/dev/null || true)"
if [ -n "$matches" ]; then
    echo "presentation imports provider adapters (crate::meter):" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
exit 0

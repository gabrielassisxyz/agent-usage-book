#!/usr/bin/env bash
# Boundary: presentation must not import provider adapters.
# Design: PLAN.md section 8.2 ("presentation importing provider adapters") and section 9
#   ("Presentation receives already-typed report objects").
# Detection: any reference to crate::meter (the module that owns provider adapters) in
#   the presentation module source, wherever it lives: the flat file when it is a file,
#   every .rs under the directory when it is a directory. mod.rs is not special-cased;
#   a renderer reaching for an adapter would do it from any file in the module.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

source "$script_dir/lib/module-files.sh"

sources=()
while IFS= read -r file; do
    [ -n "$file" ] && sources+=("$file")
done < <(module_files presentation)

if [ "${#sources[@]}" -eq 0 ]; then
    exit 2
fi

matches="$(grep -nHE 'crate::meter([^A-Za-z0-9_]|$)' "${sources[@]}" 2>/dev/null || true)"
if [ -n "$matches" ]; then
    echo "presentation imports provider adapters (crate::meter):" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
exit 0

#!/usr/bin/env bash
# Boundary: presentation must not import the store or the calibration module.
# Design: PLAN.md section 8.2 and section 9 ("Presentation receives already-typed
#   report objects"). The store and calibration modules own persistence and the
#   credits-to-window relationship; a renderer that reaches either would compute a
#   quantity instead of receiving a finished report object.
# Detection: any reference to crate::store or crate::calibration in the presentation
#   module source, wherever it lives: the flat file when it is a file, every .rs under
#   the directory when it is a directory. mod.rs is not special-cased.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

if [ -f "src/presentation.rs" ]; then
    sources=(src/presentation.rs)
elif [ -d "src/presentation" ]; then
    sources=()
    while IFS= read -r file; do
        sources+=("$file")
    done < <(find src/presentation -name '*.rs' -type f | sort)
else
    echo "presentation must not import store or calibration: no src/presentation.rs or src/presentation/ found" >&2
    exit 2
fi

matches="$(grep -nHE 'crate::(store|calibration)([^A-Za-z0-9_]|$)' "${sources[@]}" 2>/dev/null || true)"
if [ -n "$matches" ]; then
    echo "presentation imports store or calibration:" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
exit 0

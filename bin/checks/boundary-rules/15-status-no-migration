#!/usr/bin/env bash
# Boundary: the status path must not reference the migration framework.
# Design: PLAN.md section 11.4 ("aub status must never run a migration"),
#   section 16.2 (the status contract: "schema migrations" and "lock waiting" are
#   on the must-not list), and bead aub-sth.4.
# Detection: any reference to the store migration module (crate::store::migrate)
#   in the status path source. The status command is implemented in src/cli.rs
#   (chosen because that is where `fn status` and the CLI status execution workflow live)
#   and the projection module in src/projection.rs / src/projection/, so those are the files
#   checked for migrations.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

source "$script_dir/lib/module-files.sh"

sources=()
while IFS= read -r file; do
    [ -n "$file" ] && sources+=("$file")
done < <(module_files projection)

while IFS= read -r file; do
    [ -n "$file" ] && sources+=("$file")
done < <(module_files cli)

if [ "${#sources[@]}" -eq 0 ]; then
    echo "status must not reference the migration framework: no status source files found" >&2
    exit 2
fi

matches="$(grep -nHE 'crate::store::migrate([^A-Za-z0-9_]|$)' "${sources[@]}" 2>/dev/null || true)"
if [ -n "$matches" ]; then
    echo "status path references the migration framework (crate::store::migrate):" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
exit 0

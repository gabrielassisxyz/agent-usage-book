#!/usr/bin/env bash
# Boundary: status must not reference the HTTP transport layer.
# Design: PLAN.md section 8.2 ("status referencing the HTTP transport layer"), section
#   16.2 ("aub status must not perform HTTP"), and section 34.31.
# Detection: any reference to an HTTP client crate (ureq, reqwest, http, hyper, curl,
#   isahc, attohttpc) in the projection module source. projection is the status
#   projection the status workflow reads, so this is where the transport could leak in.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

source_file="src/projection.rs"
if [ ! -r "$source_file" ]; then
    echo "status must not reference the HTTP transport layer: cannot read $source_file" >&2
    exit 2
fi

matches="$(grep -nHE '(ureq|reqwest|http|hyper|curl|isahc|attohttpc)::' "$source_file" 2>/dev/null || true)"
if [ -n "$matches" ]; then
    echo "status references the HTTP transport layer:" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
exit 0

#!/usr/bin/env bash
# Boundary: no SQL statement outside src/store/.
# Design: PLAN.md sections 8.2, 9, 34.6 (aub-f7gt); src/store/ is the only module
#   permitted to speak SQL, so a SQL statement anywhere else means persistence
#   logic escaped its boundary.
# Detection: a SQL statement keyword (SELECT, INSERT, UPDATE, DELETE, CREATE TABLE,
#   PRAGMA) as an exact uppercase word in any .rs file under src/ outside
#   src/store/. Uppercase distinguishes an actual SQL keyword from the same word
#   used in prose or in a Rust identifier, which this codebase always spells in
#   lowercase or PascalCase.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(cd -- "$script_dir/../../.." && pwd)"
cd "$repo_root"

sources=()
while IFS= read -r file; do
    [ -n "$file" ] && sources+=("$file")
done < <(find src -name '*.rs' -type f -not -path 'src/store/*' | sort)

if [ "${#sources[@]}" -eq 0 ]; then
    echo "sql-only-in-store: no source files found outside src/store/" >&2
    exit 2
fi

matches="$(grep -nHE '\b(SELECT|INSERT|UPDATE|DELETE|PRAGMA)\b|CREATE TABLE' "${sources[@]}" 2>/dev/null || true)"
if [ -n "$matches" ]; then
    echo "SQL statement keyword found outside src/store/:" >&2
    printf '%s\n' "$matches" >&2
    exit 1
fi
exit 0

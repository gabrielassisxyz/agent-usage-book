#!/usr/bin/env bash
set -euo pipefail
# Passing tests normally hide their captured stderr. Keep the invariant skip marker in
# the gate transcript so a clean clone cannot look as if tracker membership was checked.
set +e
test_output="$(cargo test -- --nocapture 2>&1)"
test_status=$?
set -e
printf '%s\n' "$test_output"

if [ "$test_status" -ne 0 ]; then
    exit "$test_status"
fi

if [ -f .beads/issues.jsonl ]; then
    case "$test_output" in
        *"[INVARIANT_TRACKER_MEMBERSHIP_SKIPPED]"*)
            echo "invariant tracker-membership skip marker was surfaced while .beads/issues.jsonl is present" >&2
            exit 1
            ;;
    esac
else
    case "$test_output" in
        *"[INVARIANT_TRACKER_MEMBERSHIP_SKIPPED]"*) ;;
        *)
            echo "invariant tracker-membership skip marker was not surfaced by cargo test when tracker is absent" >&2
            exit 1
            ;;
    esac
fi

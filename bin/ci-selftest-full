#!/usr/bin/env bash
# Proves the REAL bin/checks/ commands catch the regression each one exists to catch,
# plus two whole-repo integration scenarios (install-hooks idempotence, a fresh clone is
# green with no manual step). Complements bin/ci-selftest, which proves the dispatcher's
# own mechanics against synthetic stub checks and never touches cargo.
#
# format and the prose guard are grep/syntax-only: no compilation, so they run
# unconditionally and cheaply, each against its own fresh local clone so a mutation in
# one scenario can never leak into another.
#
# lint, test, audit and the fresh-clone scenario each require a real cargo build
# (clippy and test compile the crate; audit resolves and reads the advisory database;
# the fresh-clone scenario runs the whole bin/ci, which runs all of the above). Under
# this project's code-first swarm discipline a pane runs `cargo check` only and leaves
# building to the batch-verify pass, and a per-pane build against a shared tree that
# other panes are actively editing can fail for reasons that have nothing to do with
# this bead. Those four scenarios are SKIPPED unless CI_SELFTEST_RUN_BUILD=1, which is
# what CI and the batch-verify pass are expected to set.
set -uo pipefail

repo_root="$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)"
fail=0
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT
run_build_scenarios="${CI_SELFTEST_RUN_BUILD:-0}"

note_fail() {
    echo "FAIL: $1" >&2
    fail=1
}

# --- toolchain: the gate that catches a compiler which reports the pinned version and is
# not the pinned build. Both mutations shadow a binary rather than touching the machine's
# real toolchain, the same technique the audit scenario uses further down, so this runs
# unconditionally and changes nothing outside the scratch directory.
toolchain_shadow="$scratch/toolchain-shadow"
mkdir -p "$toolchain_shadow"

# A distribution rustc: reports the pinned version, and a sysroot that is not the pin's.
cat > "$toolchain_shadow/rustc" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
    --print) [ "${2:-}" = sysroot ] && { echo /usr; exit 0; } ;;
    --version) echo "rustc 1.97.1 (8bab26f4f 2026-07-14) (Distro Linux rust 1:1.97.1-1)"; exit 0 ;;
esac
exit 0
EOF
chmod +x "$toolchain_shadow/rustc"

clone="$scratch/toolchain-distro"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
output="$( (cd "$clone" && PATH="$toolchain_shadow:$PATH" bin/checks/05-toolchain) 2>&1 )"
if [ $? -eq 0 ]; then
    note_fail "toolchain: expected the check to reject a rustc whose sysroot is not the pin's"
elif ! printf '%s' "$output" | grep -qF -- "is not the pinned toolchain"; then
    note_fail "toolchain: rejected the shadowed rustc without naming the mismatch"
    printf '%s\n' "$output" >&2
fi

# No rustup at all: the pin cannot be resolved, so the check must say so rather than
# quietly comparing a compiler against itself.
# Built by dropping every PATH entry that holds a rustup, rather than by listing the tools
# the check needs: a shim directory would have to carry bash and the coreutils the check
# and its own shebang resolve through, and a list like that goes stale the moment the check
# reaches for one more.
norustup=""
while IFS= read -r -d ':' dir; do
    [ -n "$dir" ] || continue
    [ -x "$dir/rustup" ] && continue
    norustup="$norustup${norustup:+:}$dir"
done < <(printf '%s:' "$PATH")
clone="$scratch/toolchain-missing-rustup"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
output="$( (cd "$clone" && PATH="$norustup" bin/checks/05-toolchain) 2>&1 )"
if [ $? -eq 0 ]; then
    note_fail "toolchain: expected the check to fail when rustup is absent"
elif ! printf '%s' "$output" | grep -qF -- "rustup is not on PATH"; then
    note_fail "toolchain: failed without rustup, but never named rustup"
    printf '%s\n' "$output" >&2
fi

# --- format: a stray run of blank lines is a real cargo-fmt violation. Checked against
# a baseline first, so a pre-existing formatting problem elsewhere in an actively edited
# shared tree is reported as itself rather than misread as this scenario's result. ---
clone="$scratch/format"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
if ! (cd "$clone" && cargo fmt --check) >/tmp/ci-selftest-format-baseline.log 2>&1; then
    note_fail "format: baseline clone is not fmt-clean before any mutation; see /tmp/ci-selftest-format-baseline.log"
else
    printf '\n\n\n' >> "$clone/src/build_info.rs"
    if (cd "$clone" && cargo fmt --check) >/tmp/ci-selftest-format.log 2>&1; then
        note_fail "format: expected cargo fmt --check to reject the injected blank lines"
    fi
fi

# --- prose guard: an em-dash is exactly what bin/slop-guard exists to catch. ---
clone="$scratch/prose"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
if ! (cd "$clone" && bin/slop-guard) >/tmp/ci-selftest-prose-baseline.log 2>&1; then
    note_fail "prose guard: baseline clone is not slop-clean before any mutation; see /tmp/ci-selftest-prose-baseline.log"
else
    printf '\n// An em dash for the guard to catch \xe2\x80\x94 nothing else.\n' >> "$clone/src/build_info.rs"
    if (cd "$clone" && bin/slop-guard) >/tmp/ci-selftest-prose.log 2>&1; then
        note_fail "prose guard: expected bin/slop-guard to reject the injected em-dash"
    fi
fi

# --- quantity inventory: bin/checks/70-quantity-inventory covers all public types in src/domain/
# and rejects Default implementations/derives while ignoring comments and strings. ---
clone="$scratch/quantity-inventory-baseline"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
if ! (cd "$clone" && bin/checks/70-quantity-inventory) >/tmp/ci-selftest-quantity-baseline.log 2>&1; then
    note_fail "quantity inventory: baseline clone fails before any mutation; see /tmp/ci-selftest-quantity-baseline.log"
fi

# Mutant 1: planting #[derive(Default)] on a domain type (must fail)
clone="$scratch/quantity-inventory-derive-default"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
sed -i 's/^pub struct RowCount(u64);/#[derive(Default)]\npub struct RowCount(u64);/' "$clone/src/domain/rows.rs"
output="$( (cd "$clone" && bin/checks/70-quantity-inventory) 2>&1 )"
if [ $? -eq 0 ]; then
    note_fail "quantity inventory: expected check to fail when #[derive(Default)] is planted on RowCount"
elif ! printf '%s' "$output" | grep -qF -- "forbidden Default derive on RowCount"; then
    note_fail "quantity inventory: failed on derive(Default), but never named 'forbidden Default derive on RowCount'"
    printf '%s\n' "$output" >&2
fi

# Mutant 2: planting the word Default in a comment (must pass)
clone="$scratch/quantity-inventory-comment-default"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
printf '\n// A comment discussing Default trait behavior.\n' >> "$clone/src/domain/rows.rs"
if ! (cd "$clone" && bin/checks/70-quantity-inventory) >/tmp/ci-selftest-quantity-comment.log 2>&1; then
    note_fail "quantity inventory: expected check to pass with 'Default' in a comment; see /tmp/ci-selftest-quantity-comment.log"
fi

# Mutant 3: planting an uninventoried public struct (must fail)
clone="$scratch/quantity-inventory-uninventoried-type"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
printf '\npub struct UninventoriedDomainType(u64);\n' >> "$clone/src/domain/rows.rs"
output="$( (cd "$clone" && bin/checks/70-quantity-inventory) 2>&1 )"
if [ $? -eq 0 ]; then
    note_fail "quantity inventory: expected check to fail when an uninventoried type is added"
elif ! printf '%s' "$output" | grep -qF -- "not in docs/domain-quantity-inventory.md: UninventoriedDomainType"; then
    note_fail "quantity inventory: failed on uninventoried type, but never named 'UninventoriedDomainType'"
    printf '%s\n' "$output" >&2
fi

# --- commit protocol: bin/checks/75-commit-protocol has a conformance half over AGENTS.md
# and an integration half over a scratch git repository, and each half is mutated here.
# A prose guard that keeps passing after its sentence is deleted is checking nothing, and
# an integration assertion that keeps passing after the behaviour is inverted is worse,
# because it reads as a proof. Both halves are grep and git only, so they run
# unconditionally alongside format and the prose guard rather than behind the build flag.
commit_protocol_mutant() {  # $1 = label, $2 = clone dir, $3 = expected substring in output
    local label="$1" clone="$2" needle="$3" output
    output="$( (cd "$clone" && bin/checks/75-commit-protocol) 2>&1 )"
    if [ $? -eq 0 ]; then
        note_fail "commit protocol: $label: expected the check to fail after the mutation"
        return
    fi
    if ! printf '%s' "$output" | grep -qF -- "$needle"; then
        note_fail "commit protocol: $label: failed, but never named '$needle'"
        printf '%s\n' "$output" >&2
    fi
}

clone="$scratch/commit-protocol-baseline"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
if ! (cd "$clone" && bin/checks/75-commit-protocol) >/tmp/ci-selftest-commit-protocol-baseline.log 2>&1; then
    note_fail "commit protocol: baseline clone fails before any mutation; see /tmp/ci-selftest-commit-protocol-baseline.log"
fi

# Conformance, the sentence that six deadlocked panes were missing.
clone="$scratch/commit-protocol-sentence"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
grep -v 'A foreign staged path is not a reason to stop' "$clone/AGENTS.md" > "$clone/AGENTS.md.mutant"
mv "$clone/AGENTS.md.mutant" "$clone/AGENTS.md"
commit_protocol_mutant "deleted sentence" "$clone" "a foreign staged path is not a reason to stop"

# Conformance, the orchestrator's own rule, which lives in a different section and would
# survive any mutation aimed at the pane protocol.
clone="$scratch/commit-protocol-orchestrator"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
grep -v 'does not model file overlap' "$clone/AGENTS.md" > "$clone/AGENTS.md.mutant"
mv "$clone/AGENTS.md.mutant" "$clone/AGENTS.md"
commit_protocol_mutant "deleted orchestrator rule" "$clone" "sequences overlapping blast radii"

# Integration, the path-scoped commit: a bare commit is the form the doctrine bans, and it
# sweeps the foreign staged path in. If the assertion is live, the check says so.
clone="$scratch/commit-protocol-bare-commit"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
sed -i 's/^git -C "\$scratch" commit --quiet -m "subject" -m "aub-me8b" -- mine.rs$/git -C "$scratch" commit --quiet -m "subject" -m "aub-me8b"/' \
    "$clone/bin/checks/75-commit-protocol"
commit_protocol_mutant "bare commit" "$clone" "carried more than its own paths"

# Integration, the shared-file test: --cached compares the index, so it cannot see an
# uncommitted foreign line, which is the whole reason the doctrine says HEAD.
clone="$scratch/commit-protocol-cached-diff"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
sed -i 's/diff HEAD -- mod\.rs/diff --cached -- mod.rs/' "$clone/bin/checks/75-commit-protocol"
commit_protocol_mutant "index-scoped diff" "$clone" "did not report the foreign line"

# --- batch-verify close protocol: bin/checks/80-batch-verify-close guards Phase 2 close procedure
# conformance over AGENTS.md and integration on a scratch tracker. Mutate each half here.
batch_verify_close_mutant() {  # $1 = label, $2 = clone dir, $3 = expected substring in output
    local label="$1" clone="$2" needle="$3" output
    output="$( (cd "$clone" && bin/checks/80-batch-verify-close) 2>&1 )"
    if [ $? -eq 0 ]; then
        note_fail "batch-verify close: $label: expected the check to fail after the mutation"
        return
    fi
    if ! printf '%s' "$output" | grep -qF -- "$needle"; then
        note_fail "batch-verify close: $label: failed, but never named '$needle'"
        printf '%s\n' "$output" >&2
    fi
}

clone="$scratch/batch-verify-close-baseline"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
if ! (cd "$clone" && bin/checks/80-batch-verify-close) >/tmp/ci-selftest-batch-verify-close-baseline.log 2>&1; then
    note_fail "batch-verify close: baseline clone fails before any mutation; see /tmp/ci-selftest-batch-verify-close-baseline.log"
fi

# Conformance, planting the refused br gate report command back into AGENTS.md
clone="$scratch/batch-verify-close-gate-report"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
sed -i 's/br close <id>/br gate report <id> --gate batch_verify --provider batch-orchestrator --status pass --to closed\nbr close <id>/' "$clone/AGENTS.md"
batch_verify_close_mutant "re-introduced gate report" "$clone" "forbidden 'br gate report <id>' present"

# Conformance, deleting the reason for dropping structured gates
clone="$scratch/batch-verify-close-rationale"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
grep -v 'Why structured gate reporting' "$clone/AGENTS.md" > "$clone/AGENTS.md.mutant"
mv "$clone/AGENTS.md.mutant" "$clone/AGENTS.md"
batch_verify_close_mutant "deleted rationale" "$clone" "reason for dropping structured gate"

# Conformance, deleting the evidence location and audit description
clone="$scratch/batch-verify-close-evidence"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
grep -v 'Batch-verify evidence lives directly in' "$clone/AGENTS.md" > "$clone/AGENTS.md.mutant"
mv "$clone/AGENTS.md.mutant" "$clone/AGENTS.md"
batch_verify_close_mutant "deleted evidence description" "$clone" "batch-verify evidence location and audit"

# Integration, corrupting the scratch close command
clone="$scratch/batch-verify-close-bad-command"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
sed -i 's/br close "\$bead_id"/br close "\$bead_id" --nonexistent-unsupported-flag/' "$clone/bin/checks/80-batch-verify-close"
batch_verify_close_mutant "corrupted close command" "$clone" "documented close command failed"

# --- install-hooks: running it twice must be idempotent. ---
clone="$scratch/hooks"
git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
(cd "$clone" && bin/install-hooks) >/tmp/ci-selftest-hooks1.log 2>&1 || note_fail "install-hooks: first run failed"
(cd "$clone" && bin/install-hooks) >/tmp/ci-selftest-hooks2.log 2>&1 || note_fail "install-hooks: second run failed"
hooks_path="$(cd "$clone" && git config --get core.hooksPath || true)"
[ "$hooks_path" = ".githooks" ] || note_fail "install-hooks: core.hooksPath is '$hooks_path', expected .githooks"
for h in commit-msg pre-commit; do
    [ -x "$clone/.githooks/$h" ] || note_fail "install-hooks: $h is not executable after two runs"
done

if [ "$run_build_scenarios" != 1 ]; then
    echo "CI_SELFTEST_RUN_BUILD is not 1: skipping lint, test, audit and the fresh-clone scenario."
    echo "These require a real cargo build and are left to CI / batch-verify."
else
    # --- lint: an unused local is a real clippy warning under -D warnings. ---
    clone="$scratch/lint"
    git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
    cat >> "$clone/src/build_info.rs" <<'EOF'

#[allow(dead_code)]
fn ci_selftest_unused_variable_mutant() {
    let unused = 1;
}
EOF
    if (cd "$clone" && cargo clippy --all-targets -- -D warnings) >/tmp/ci-selftest-lint.log 2>&1; then
        note_fail "lint: expected clippy -D warnings to reject the unused variable"
    fi

    # --- test: a deliberately wrong assertion is a real test failure. ---
    clone="$scratch/test"
    git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
    sed -i 's/assert_eq!(crate_version(), version_from_manifest());/assert_eq!(crate_version(), "not-the-real-version");/' \
        "$clone/src/build_info.rs"
    if (cd "$clone" && cargo test) >/tmp/ci-selftest-test.log 2>&1; then
        note_fail "test: expected the mutated assertion to fail cargo test"
    fi

    # --- audit: proves cargo audit's exit code reaches bin/ci, by shadowing the binary
    # rather than vendoring a real advisory, since this project pins no known-vulnerable
    # dependency to break on purpose. ---
    fake_bin="$scratch/fake-bin"
    mkdir -p "$fake_bin"
    cat > "$fake_bin/cargo-audit" <<'EOF'
#!/usr/bin/env bash
echo "ci-selftest: simulated advisory" >&2
exit 1
EOF
    chmod +x "$fake_bin/cargo-audit"
    clone="$scratch/audit"
    git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
    if (cd "$clone" && PATH="$fake_bin:$PATH" cargo audit) >/tmp/ci-selftest-audit.log 2>&1; then
        note_fail "audit: expected the simulated advisory to fail the check"
    fi

    # --- fresh clone: install-hooks + bin/ci is green with no manual step. ---
    clone="$scratch/fresh"
    git clone --quiet --local --no-hardlinks "$repo_root" "$clone"
    if ! (cd "$clone" && bin/install-hooks && bin/ci) >/tmp/ci-selftest-fresh.log 2>&1; then
        note_fail "fresh clone: install-hooks && bin/ci was not green; see /tmp/ci-selftest-fresh.log"
    fi
fi

if [ "$fail" -ne 0 ]; then
    echo "==> bin/ci-selftest-full FAILED"
    exit 1
fi
echo "bin/ci-selftest-full: all scenarios pass."

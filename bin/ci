#!/usr/bin/env bash
# The deterministic gate. This is the exact thing CI runs, so "green locally" means
# "green in CI". Every check accumulates into `fail` rather than exiting early, so one
# broken check does not hide the state of the others.
set -euo pipefail

fail=0

# A tool this project cannot run without is a dependency, not a hurdle to document. A
# `command -v X || exit 0` guard would turn the gate off on exactly the machine that
# lacks the tool, and still report green.
for b in cargo cargo-audit git; do
    if ! command -v "$b" >/dev/null 2>&1; then
        echo "missing: $b" >&2
        fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "==> bin/ci FAILED"
    exit 1
fi

# >>> repo-harness:cargo-build-root >>>
# Build somewhere no other checkout of this package can reach.
#
# WHY a directory per worktree: where cargo's `build.target-dir` points every checkout at
# one directory, two worktrees of the same package write the same artifact paths and the
# fingerprints do not tell them apart. The gate then judges units another branch built and
# passes without compiling the current sources: new tests never appear in the output, and
# `CARGO_BIN_EXE_<name>` starts a binary from another branch. That has already produced a
# green run for code that was never built, and a conclusion that the default branch was
# failing when it was not.
#
# WHY on the build disk and not in tmpfs: this block used to point at /tmp, because the
# alternative at the time was a DRAM-less SSD behind btrfs and dm-crypt whose write volume
# stalled the whole desktop for seconds at a time. /mnt/build is a different disk (plain
# ext4, no COW, no cryptography) added on 2026-08-09 to carry exactly this traffic, so the
# reason to spend RAM instead is gone. It was spending real RAM: three worktrees of one
# crate held 1.3 GB of tmpfs against the 268 MB a single cold build was measured at,
# because incremental artifacts (dependency graph, query cache, test binaries) accumulate
# across runs. And tmpfs is not free memory even when it looks idle: under pressure those
# pages go to zram, which is still RAM, only compressed.
#
# WHY a sibling of cargo-target rather than a child: ~/.cargo/config.toml points
# `build.target-dir` at /mnt/build/cargo-target for ordinary builds. Nesting the
# per-worktree directories inside it would make a `cargo clean` in any main checkout wipe
# them all.
#
# The tmpfs fallback is what keeps the gate portable, and it is not a leftover: the build
# disk is one machine's arrangement, and a CI runner has no such mount. An explicit
# CARGO_TARGET_DIR still wins for anyone who wants a different arrangement, and the path is
# derived from the checkout either way, so repeated runs in one worktree reuse their build.
if [ -z "${CARGO_TARGET_DIR:-}" ]; then
    build_root=/mnt/build
    [ -d "$build_root" ] || build_root="${TMPDIR:-/tmp}"
    CARGO_TARGET_DIR="$build_root/cargo-target-worktrees/$(basename "$PWD")"
    export CARGO_TARGET_DIR
fi
echo "==> building in $CARGO_TARGET_DIR"
# <<< repo-harness:cargo-build-root <<<

echo "==> format check"
cargo fmt --check || fail=1

# --all-targets, because without it clippy never looks at a test target. The invariants
# this project cares about (units, freshness) are asserted in tests, so exempting them
# from the lint gate exempts the reasoning.
echo "==> lint"
cargo clippy --all-targets -- -D warnings || fail=1

echo "==> test"
cargo test || fail=1

echo "==> dependency audit"
cargo audit || fail=1

# Last, so a prose finding never masks a compile or test failure. The scan is whole-tree
# and not diff-scoped: this repo started clean, so zero tolerance is reachable here, and
# nothing gets grandfathered in by adopting a weaker posture later.
echo "==> prose guard"
bin/slop-guard || fail=1

if [ "$fail" -ne 0 ]; then
    echo "==> bin/ci FAILED"
    exit 1
fi

echo "CI green."
